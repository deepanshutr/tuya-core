# Copy to ~/.config/tuya/state.env and adjust to your LAN.
# This file is committed; the real one is NOT.

# Daemon bind
# TUYA_BIND=127.0.0.1:8768

# Discovery — seconds to listen on UDP 6666/6667 per pass
# TUYA_DISCOVER_LISTEN_S=3.0

# Refresh + re-discover cadences (seconds)
# TUYA_REFRESH_INTERVAL_S=60
# TUYA_DISCOVER_INTERVAL_S=600

# Max concurrent bulbs in a /bulb/all/{op} fan-out
# TUYA_ALL_CONCURRENCY=16

# Logging + state
# TUYA_LOG_LEVEL=INFO
# TUYA_STATE_DIR=~/.config/tuya

# NOTE: the per-device AES local keys live in ~/.config/tuya/keys.json,
# NOT here. That file is a secret — keep it chmod 600, never commit it.
