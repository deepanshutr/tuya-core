[Unit]
Description=tuya-core — Tuya smart-bulb control daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/tuya/state.env
ExecStart=%h/.local/bin/tuya-core serve
Restart=on-failure
RestartSec=5

# Hardening (only flags that work in user-scope; see
# feedback_systemd_user_hardening in user memory)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.config/tuya

[Install]
WantedBy=default.target
